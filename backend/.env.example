# 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=5679

# 前端地址(用于CORS)
CORS_ORIGIN=http://localhost:5173

# 聚合API配置 (OpenAI兼容格式)
API_BASE_URL=https://your-api-gateway.com/v1
API_KEY=sk-your-aggregated-api-key-here

# 数据库路径
DB_PATH=./data/drama.db

# 文件存储路径
STORAGE_PATH=./data/storage

# 静态资源访问URL
STATIC_URL=http://localhost:5679/static
